# ==============================================================================
# GrammaLab API — Variables de entorno (copiar a apps/api/.env)
# Nunca commitear apps/api/.env con credenciales reales.
# ==============================================================================

# --- Base de datos PostgreSQL 17 ---
# Modo A (Docker opcional: ejecutar `npm run db:up` desde la raíz):
DATABASE_URL="postgresql://grammalab:grammalab@localhost:5432/grammalab?schema=public"

# Modo B (PostgreSQL 17 instalado localmente, sin Docker):
# Crea la base `grammalab` en tu instancia local y descomenta/ajusta esta línea:
# DATABASE_URL="postgresql://<tu_usuario>:<tu_clave>@localhost:5432/grammalab?schema=public"

# --- Servidor NestJS ---
PORT=3000
NODE_ENV=development

# Orígenes permitidos para CORS (separados por coma si hay más de uno)
CORS_ORIGIN="http://localhost:5173"

# --- Autenticación JWT (Subfase 1.4) ---
JWT_SECRET="cambia-este-secreto-en-desarrollo-y-produccion"
JWT_EXPIRES_IN="7d"

# --- Asistente Pedagógico IA — Plan Gratuito (Subfase 3.2) ---
# Proveedor principal: Google AI Studio (Gemini API Free)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Proveedor de respaldo automático ante HTTP 429 / 5xx / timeout: Groq Cloud (Free)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
